{
  "name": "@our-players/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "fixtures:record": "tsx scripts/fixtures-record.ts",
    "inspect": "tsx scripts/inspect.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/cli.ts migrate",
