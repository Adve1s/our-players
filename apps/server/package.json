    "recap": "tsx scripts/recap.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@hono/node-server": "^2.1.5",
    "@our-players/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.13",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15"
  }
