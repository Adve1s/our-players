# No `log` directive in the site block, so Caddy writes no access log (the API logs paths without
# query strings). Caddy's own error logs still carry the request URI (e.g. while the API restarts):
# the filter cuts it at `?` so preferences in the query (countries, favorites) never reach a log,
# and drops the client address, so no log holds IP addresses. That includes X-Forwarded-For: the proxy's
# own warning (a response cut off mid-copy) logs the outgoing request, with the client address in that header.
# The same warning's `error` quotes the client address when a write to a client that left fails
# ("write tcp <server>-><client>:<port>: ..."), so the regexp cuts the `->` part. The line's `upstream` still names the API.
{
	log default {
		format filter {
			request>uri regexp [?].* ""
			request>remote_ip delete
			request>client_ip delete
			request>headers>X-Forwarded-For delete
			error regexp "->[^ ]+" ""
		}
	}
}

{$API_HOST} {
	reverse_proxy api:3001
}
