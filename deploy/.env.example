# Copy to /opt/our-players/.env on the host (never commit the real file). See docs/DEPLOY.md.
# The API's public hostname; Caddy gets its certificate for it.
API_HOST=<name>.dedyn.io
# Database password, generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Browser origins allowed to read /v1 (comma-separated), e.g. the S14a web build
CORS_ORIGINS=https://our-players.<cloudflare-subdomain>.workers.dev
# Image tag to run; deploy.sh sets it to the deployed commit (git rev-parse --short HEAD)
API_TAG=<git-short-sha>
# 1 runs the ingestion scheduler inside the API (default); 0 switches it off
SCHEDULER_ENABLED=1
# Optional: contact URL in the upstream User-Agent (default: the GitHub repo)
CONTACT_URL=
