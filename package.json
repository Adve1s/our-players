{
  "name": "our-players",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "dev:server": "pnpm --filter @our-players/server dev",
    "dev:mobile": "pnpm --filter @our-players/mobile start",
    "fixtures:record": "pnpm --filter @our-players/server fixtures:record",
    "inspect": "pnpm --filter @our-players/server inspect",
    "job": "pnpm --filter @our-players/server job",
    "recap": "pnpm --filter @our-players/server recap",
    "latency": "pnpm --filter @our-players/server latency",
    "probe": "pnpm --filter @our-players/server probe",
    "db:generate": "pnpm --filter @our-players/server db:generate",
    "db:migrate": "pnpm --filter @our-players/server db:migrate",
    "db:reset": "pnpm --filter @our-players/server db:reset",
    "screenshots": "pnpm --filter @our-players/mobile screenshots",
    "serve:web": "pnpm --filter @our-players/mobile serve:web",
    "build:web": "pnpm --filter @our-players/mobile build:web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
